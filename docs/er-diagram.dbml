// JanSahay v1.0 - ER diagram (PostgreSQL 16)
// Paste this whole file into https://dbdiagram.io/d to see the diagram.
// v1.1 tables (users, user_profiles, consents, alert_preferences,
// program_events, notifications) are NOT here on purpose: add them
// after Gate G1. See section 3.2 of the Implementation Workflow.
//
// Conventions used everywhere:
//   - every table has an integer primary key called id
//   - foreign keys are named <table_singular>_id
//   - allowed values for text columns are in the column note; enforce them
//     later with CHECK constraints (or Enums) in the Alembic migration
//   - "delete: cascade"  = delete the parent and its children go too
//   - "delete: restrict" = block deleting the parent while children exist

// ---------------------------------------------------------------
// 1. ADMIN
// ---------------------------------------------------------------
Table admin_users {
  id int [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null, note: 'bcrypt or argon2 hash. Never the password.']
  role varchar(20) [not null, default: 'admin', note: 'admin only in v1.0']
  is_active boolean [not null, default: true, note: 'deactivate instead of deleting']
  created_at timestamp [not null, default: `now()`]

  Note: 'Separate from public users (those come in v1.1).'
}

// ---------------------------------------------------------------
// 2. CATALOG: needs and the questions asked for each need
// ---------------------------------------------------------------
Table categories {
  id int [pk, increment]
  code varchar(40) [not null, unique, note: 'education, housing, business, agriculture, skills, self_employment, other']
  name varchar(100) [not null]
  description text
  display_order int [not null, default: 0]

  Note: 'The need the user picks first.'
}

Table questions {
  id int [pk, increment]
  category_id int [note: 'NULL = common question asked in every category']
  field_key varchar(60) [not null, unique, note: 'machine name, e.g. age, annual_family_income, state']
  label varchar(255) [not null, note: 'what the user sees']
  help_text text
  why_we_ask text [note: 'shown as the why-we-ask line']
  answer_type varchar(20) [not null, note: 'number, text, boolean, single_choice, multi_choice']
  options_json jsonb [note: 'choices for single/multi choice questions']
  display_order int [not null, default: 0]
  depends_on_key varchar(60) [note: 'only ask if this other question has the value below']
  depends_on_value varchar(100)

  indexes {
    (category_id, display_order)
  }

  Note: 'Also acts as the field dictionary: rules point to a question.'
}

// ---------------------------------------------------------------
// 3. PROGRAMS (schemes) and what is known about each
// ---------------------------------------------------------------
Table programs {
  id int [pk, increment]
  category_id int [not null]
  created_by int [note: 'admin who created it. Nullable so seed data can load before an admin exists']
  name varchar(255) [not null, note: 'official scheme name']
  abbreviation varchar(40)
  govt_level varchar(10) [not null, note: 'central or state']
  state_code varchar(5) [note: 'e.g. KA. NULL for central schemes']
  primary_type varchar(20) [not null, note: 'loan, subsidy, grant, scholarship, guarantee, rental, recognition, other']
  purpose text
  summary text
  benefit_text text
  amount_min numeric(14,2) [note: 'only if the source states it']
  amount_max numeric(14,2) [note: 'only if the source states it']
  interest_text varchar(255)
  tenure_text varchar(255)
  implementing_authority varchar(255)
  operational_status varchar(20) [not null, default: 'unclear', note: 'active, unclear, suspended, discontinued. Never publish unclear.']
  application_window_text varchar(255) [note: 'Rolling, a date range, or Not stated']
  scheme_version varchar(40) [note: 'separates legacy from current schemes']
  status varchar(20) [not null, default: 'draft', note: 'draft, published, archived']
  last_verified_on date [note: 'the date a human read the official page']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (status, category_id, govt_level, state_code)
  }

  Note: 'operational_status (is the scheme alive?) and status (is our record published?) are different things.'
}

Table benefit_components {
  id int [pk, increment]
  program_id int [not null]
  component_type varchar(30) [not null, note: 'e.g. bank_loan, margin_money_subsidy, interest_subvention']
  description text

  Note: 'One primary_type on programs, plus extra components here.'
}

Table benefit_variants {
  id int [pk, increment]
  program_id int [not null]
  label varchar(100) [not null]
  conditions_json jsonb [note: 'e.g. region, category, income band']
  amount_text varchar(255)

  Note: 'Amounts that vary by condition. For display only, never used for eligibility.'
}

// ---------------------------------------------------------------
// 4. ELIGIBILITY RULES (read by the rule engine)
// ---------------------------------------------------------------
Table eligibility_rules {
  id int [pk, increment]
  program_id int [not null]
  question_id int [not null, note: 'which answer this rule checks (replaces a free-text field_key)']
  operator varchar(10) [not null, note: 'eq, neq, in, not_in, gt, gte, lt, lte, between, is_true, is_false']
  value_json jsonb [note: 'e.g. 18, ["SC","ST"], [18,40]. NULL for is_true / is_false']
  is_mandatory boolean [not null, default: true, note: 'optional rules only affect ranking']
  is_exclusion boolean [not null, default: false, note: 'if the condition is met, the program fails']
  applies_when_json jsonb [note: 'rule applies only in some cases, e.g. {"occupation":"farmer"}']
  description varchar(255) [not null, note: 'plain-language line shown to the user']
  source_section varchar(255) [note: 'where in the official page this came from']
  verification_status varchar(20) [not null, default: 'unverified', note: 'verified, unverified']

  indexes {
    program_id
  }

  Note: 'One row per condition. This table feeds matching/engine.py.'
}

// ---------------------------------------------------------------
// 5. WHAT THE USER DOES NEXT
// ---------------------------------------------------------------
Table documents {
  id int [pk, increment]
  program_id int [not null]
  name varchar(255) [not null]
  purpose varchar(255)
  requirement varchar(20) [not null, default: 'mandatory', note: 'mandatory, conditional, lender_specific']

  indexes {
    program_id
  }
}

Table application_steps {
  id int [pk, increment]
  program_id int [not null]
  step_no int [not null]
  instruction text [not null]

  indexes {
    (program_id, step_no) [unique]
  }

  Note: 'Ordered next steps. The unique pair stops two "step 2" rows for one program.'
}

Table application_channels {
  id int [pk, increment]
  program_id int [not null]
  channel_type varchar(20) [not null, note: 'portal, bank, agency, office, list_based, project_based, lender_based, local_body']
  name varchar(255) [not null]
  url varchar(500)
  contact_info varchar(255)
  verification_status varchar(20) [not null, default: 'unverified', note: 'verified only if the official page offering this program was reached']
  verified_on date

  indexes {
    program_id
  }

  Note: 'list_based and similar types tell the UI to hide a fake Apply button.'
}

// ---------------------------------------------------------------
// 6. TRUST: where facts came from, and who changed what
// ---------------------------------------------------------------
Table program_sources {
  id int [pk, increment]
  program_id int [not null]
  source_level varchar(5) [not null, note: 'O1, O2, B, N, T: how official the source is']
  title varchar(255) [not null]
  url varchar(500) [not null]
  section varchar(255)
  date_accessed date [not null, note: 'the date YOU read it']

  indexes {
    program_id
  }
}

Table audit_log {
  id int [pk, increment]
  admin_id int [not null]
  program_id int
  action varchar(30) [not null, note: 'create, edit, publish, archive, verify']
  details_json jsonb [note: 'what changed']
  created_at timestamp [not null, default: `now()`]

  indexes {
    program_id
  }

  Note: 'Every admin change to a program writes one row. Append only: never edit or delete rows.'
}

// ---------------------------------------------------------------
// RELATIONSHIPS (one-to-many: the "<" side is the many side)
// ---------------------------------------------------------------
Ref: questions.category_id > categories.id [delete: restrict]
Ref: programs.category_id > categories.id [delete: restrict]
Ref: programs.created_by > admin_users.id [delete: restrict]

Ref: benefit_components.program_id > programs.id [delete: cascade]
Ref: benefit_variants.program_id > programs.id [delete: cascade]
Ref: eligibility_rules.program_id > programs.id [delete: cascade]
Ref: documents.program_id > programs.id [delete: cascade]
Ref: application_steps.program_id > programs.id [delete: cascade]
Ref: application_channels.program_id > programs.id [delete: cascade]
Ref: program_sources.program_id > programs.id [delete: cascade]

Ref: eligibility_rules.question_id > questions.id [delete: restrict]

Ref: audit_log.admin_id > admin_users.id [delete: restrict]
Ref: audit_log.program_id > programs.id [delete: restrict]

// ---------------------------------------------------------------
// GROUPS (colours the diagram into areas)
// ---------------------------------------------------------------
TableGroup admin_area {
  admin_users
  audit_log
}

TableGroup catalog {
  categories
  questions
}

TableGroup program_core {
  programs
  benefit_components
  benefit_variants
  eligibility_rules
}

TableGroup next_steps {
  documents
  application_steps
  application_channels
  program_sources
}
